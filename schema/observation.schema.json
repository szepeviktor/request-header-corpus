{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/request-header-corpus/observation.schema.json",
  "title": "Browser request header observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client",
    "environment",
    "tls",
    "scenario",
    "request",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "engine", "channel", "driver_version"],
      "properties": {
        "name": { "enum": ["chrome", "edge", "firefox", "safari"] },
        "version": { "type": "string", "minLength": 1 },
        "engine": { "enum": ["chromium", "gecko", "webkit"] },
        "channel": { "const": "stable" },
        "driver_version": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "headless",
        "runner_image",
        "runner_image_version"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "headless": { "type": "boolean" },
        "runner_image": { "type": "string", "minLength": 1 },
        "runner_image_version": { "type": "string", "minLength": 1 }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_by_browser", "alpn", "secure_context"],
      "properties": {
        "trusted_by_browser": { "const": true },
        "alpn": { "type": ["string", "null"] },
        "secure_context": { "const": true }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "url"],
      "properties": {
        "id": { "enum": ["navigation-get", "form-post", "ajax-post"] },
        "method": { "enum": ["GET", "POST"] },
        "url": {
          "enum": [
            "https://app.test/capture/navigation",
            "https://app.test/capture/form",
            "https://app.test/capture/ajax"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_file", "measurement_id", "http_version"],
      "properties": {
        "raw_file": {
          "type": "string",
          "pattern": "^raw/(chrome|edge|firefox|safari)/[^/]+/[^/]+/(navigation-get|form-post|ajax-post)\\.txt$"
        },
        "measurement_id": { "type": "string", "format": "uuid" },
        "http_version": { "type": "string", "minLength": 1 }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
