{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/request-header-corpus/raw-request.schema.json",
  "title": "Raw browser request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "measurement_token",
    "captured_at",
    "method",
    "url",
    "http_version",
    "alpn",
    "headers",
    "raw_headers",
    "wire_capture"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "measurement_id": { "type": "string", "format": "uuid" },
    "measurement_token": { "type": "string", "minLength": 16 },
    "captured_at": { "type": "string", "format": "date-time" },
    "method": { "enum": ["GET", "POST"] },
    "url": { "type": "string", "pattern": "^/capture/" },
    "http_version": { "type": "string", "minLength": 1 },
    "alpn": { "type": ["string", "null"] },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "raw_headers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "wire_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "file",
        "connection_id",
        "stream_id",
        "byte_length",
        "sha256",
        "target_header_frames"
      ],
      "properties": {
        "format": { "const": "http2-connection-prefix-v1" },
        "file": { "type": "string", "pattern": "^raw/.+\\.h2$" },
        "connection_id": { "type": "string", "format": "uuid" },
        "stream_id": { "type": "integer", "minimum": 1 },
        "byte_length": { "type": "integer", "minimum": 42 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_header_frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "length", "type", "flags", "stream_id"],
            "properties": {
              "offset": { "type": "integer", "minimum": 24 },
              "length": { "type": "integer", "minimum": 9 },
              "type": { "enum": [1, 9] },
              "flags": { "type": "integer", "minimum": 0, "maximum": 255 },
              "stream_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
