{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/request-header-corpus/manifest.schema.json",
  "title": "Browser request header corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "environment",
        "tls",
        "scenario",
        "request",
        "observed_at"
      ],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "engine", "channel", "driver_version"],
          "properties": {
            "name": { "enum": ["chrome", "edge", "firefox", "safari"] },
            "version": { "type": "string", "minLength": 1 },
            "engine": { "enum": ["chromium", "gecko", "webkit"] },
            "channel": { "const": "stable" },
            "driver_version": { "type": "string", "minLength": 1 }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "architecture",
            "headless",
            "runner_image",
            "runner_image_version"
          ],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 },
            "headless": { "type": "boolean" },
            "runner_image": { "type": "string", "minLength": 1 },
            "runner_image_version": { "type": "string", "minLength": 1 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trusted_by_browser", "alpn", "secure_context"],
          "properties": {
            "trusted_by_browser": { "const": true },
            "alpn": { "enum": ["h2", "http/1.1"] },
            "secure_context": { "const": true }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "method", "url"],
          "properties": {
            "id": { "enum": ["navigation-get", "form-post", "ajax-post"] },
            "method": { "enum": ["GET", "POST"] },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(app\\.test|http1\\.app\\.test:444)/capture/(navigation|form|ajax)$"
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_file", "measurement_id", "http_version", "protocol"],
          "properties": {
            "raw_file": {
              "type": "string",
              "pattern": "^raw/(chrome|edge|firefox|safari)/[^/]+/[^/]+/(http1|http2)/(navigation-get|form-post|ajax-post)\\.txt$"
            },
            "measurement_id": { "type": "string", "format": "uuid" },
            "http_version": { "enum": ["1.1", "2.0"] },
            "protocol": { "enum": ["http1", "http2"] }
          }
        },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
